# Copy to .streamlit/secrets.toml for LOCAL testing only. Never commit the real file.
# On Streamlit Community Cloud paste these into: App -> Settings -> Secrets

GROQ_API_KEY = "your-groq-key-here"        # text chat
GEMINI_API_KEY = "your-gemini-key-here"    # photos + embeddings for source grounding

# --- Optional ---
# APP_PASSCODE = "choose-something"        # require a passcode before anyone can chat
# RATE_LIMIT_PER_HOUR = 40                 # per-visitor soft cap (0 = off)
# YOUTUBE_CHANNEL_ID = "UCxxxxxxxxxxxxxxxxxxxxxx"
# BLOG_RSS_URL = "https://yourblog.com/feed"
# SIMON_DB_PATH = "simon.db"               # chat history; use a persistent volume in production
# GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_FALLBACK_MODEL = "llama-3.3-70b-versatile"
# GEMINI_MODEL = "gemini-2.5-flash"
# FILE_CHAR_CAP = 12000                    # max characters kept per attached text file
# HISTORY_CHAR_BUDGET = 20000              # max characters of history sent per turn
